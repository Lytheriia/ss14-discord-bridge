INTERNAL_API_KEY=KEY

POSTGRES_DB=POSTGRES_DB
POSTGRES_USER=ADMIN
POSTGRES_PASSWORD=ADMIN
POSTGRES_PORT=4554
# Required. Host directory with the Postgres data (keep it when moving the project, or the database starts empty)
POSTGRES_DATA_DIR=/srv/ss14-discord-bridge/postgres
REDIS_PORT=6379

API_PORT=42342
# 127.0.0.1 when the SS14 server runs on the same machine, 0.0.0.0 to accept remote connections
API_BIND_HOST=127.0.0.1
# Comma-separated IPs allowed to call the API; required when API_BIND_HOST=0.0.0.0
API_ALLOWED_IPS=

SS14_SERVER_IP=255.255.255.17:3333

DISCORD_TOKEN=Token
DISCORD_GUILD_ID=53434534
# Discord user ID allowed to run maintainer-only commands
DISCORD_MAINTAINER_ID=444444444444444444
DISCORD_VERIFIED_ROLE_ID=555555555555555555
DISCORD_BOOSTER_ROLE_ID=666666666666666666

# Boosty rank role IDs, comma-separated, lowest rank first (first ID = rank 1). Empty disables Boosty.
# Append new ranks at the end: ranks are stored by position, so never reorder or remove IDs.
DISCORD_BOOSTY_ROLES=111111111111111111,222222222222222222,333333333333333333

# Weekly antag tokens per Boosty rank, comma-separated, lowest rank first. Empty disables weekly grants.
BOOSTY_WEEKLY_TOKENS=0,1,3
